# No file is loaded automatically by Python. Export vars for local processes.
# Compose: docker compose --env-file infra/.env -f infra/compose.yaml up --build
# local_codex is for the HOST with an existing CLI login; container default is disabled.
LLM_PROVIDER=disabled
TINVEST_SANDBOX_TOKEN=
# Reserved for CP1 external API adapter; not implemented/configured by these values yet.
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
