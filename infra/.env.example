# No file is loaded automatically by Python. Export vars for local processes.
# Compose: docker compose --env-file infra/.env -f infra/compose.yaml up --build
# local_codex is for the HOST with an existing CLI login; container default is disabled.
LLM_PROVIDER=disabled
TINVEST_SANDBOX_TOKEN=
# External API: pt (local development only) or deepseek.
# PT: https://api-llm.ptsecurity.com/v1 with LLM_MODEL=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=2048
LLM_MAX_INPUT_BYTES=60000
LLM_MAX_CALLS=30
LLM_MAX_RESERVED_TOKENS=200000
LLM_MAX_COST_USD=1
# Set verified upper-bound prices; zero blocks requests. No price is invented here.
LLM_INPUT_USD_PER_MILLION=0
LLM_OUTPUT_USD_PER_MILLION=0
# VPS overlay uses a separate PUBLIC key, never the corporate LLM_API_KEY.
DEEPSEEK_API_KEY=
TRADEGUARD_DOMAIN=localhost
AUTH_USER=tradeguard
AUTH_PASSWORD_HASH=
